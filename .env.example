# ============================================================
# Site
# ============================================================
NEXT_PUBLIC_SITE_URL="https://taiphanvan.dev"

# ============================================================
# UI style — đổi diện mạo public site mà không động code
# ============================================================
# Values:
#   cypher-2049   — Blade Runner 2049 × cypherpunk: amber dust + Joi pink, kanji billboards, glitch headline, CCTV scope chrome. Mặc định.
#   terminal      — dev/hacker terminal: all-mono, scanlines, phosphor green, ASCII frames, dark default.
#   neo-brutalist — bold flat colors, thick borders, hard offset shadows, chunky display sans, pop yellow accent.
# Sai giá trị thì fallback về "cypher-2049".
NEXT_PUBLIC_UI_STYLE="cypher-2049"

# ============================================================
# Database — two-URL pattern
# ============================================================
#
# DATABASE_URL is read by the app at runtime (Server Actions, route handlers,
# RSC) via @prisma/adapter-pg. Point this at the Supabase **Transaction
# pooler** (port 6543). It scales for serverless because each transaction
# checks a connection back into the pool — at the cost of no prepared
# statements / DDL / advisory locks.
#
# MIGRATE_DATABASE_URL is read by `prisma migrate`, `prisma db seed`, and
# `prisma studio` via prisma.config.ts. Point this at the Supabase **Session
# pooler** (port 5432). Long-lived session, full Postgres features.
#
# If you only have one URL (e.g. local Docker dev), set DATABASE_URL only —
# MIGRATE_DATABASE_URL falls back to it.
#
#   Supabase Dashboard → Settings → Database → Connection string
#     • Tab "Transaction pooler" → copy → DATABASE_URL (port 6543)
#     • Tab "Session pooler"     → copy → MIGRATE_DATABASE_URL (port 5432)
#
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
MIGRATE_DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Local Docker alternative (single URL, no pooler distinction needed):
# DATABASE_URL="postgresql://taiphanvan:dev@localhost:5433/taiphanvan_dev"

# ============================================================
# Tracker auth
# ============================================================
TRACKER_PASSWORD=""
# 32+ random chars, generate: openssl rand -hex 32
TRACKER_COOKIE_SECRET=""

# ============================================================
# Cron / keep-alive
# ============================================================
# Shared secret for /api/cron/keep-alive (Supabase free-tier keep-alive).
# Must match the GitHub Actions repo secret CRON_SECRET.
# 32+ random chars, generate: openssl rand -hex 32
CRON_SECRET=""
